{
  "name": "tare-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-config": "node scripts/gen-config.mjs",
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/gen-config.mjs && envio codegen && pnpm install --frozen-lockfile",
    "test": "vitest run --test-timeout=10000"
  },
  "dependencies": {
    "envio": "3.0.0-alpha.21",
    "viem": "^2.57.4"
  },
  "optionalDependencies": {
    "generated": "./generated"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
