{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "../shared/**/*.ts", "../lib/**/*.ts"],
  "exclude": ["../**/*.test.ts", "../lib/wagmi.ts"]
}
